# ---- Utility functions --------------------------------------------------------
strip_suffix <- function(x) sub("_S[0-9]+$", "", trimws(as.character(x)))

read_abund <- function(path) {
  x <- if (grepl("\\.xlsx?$", path, ignore.case = TRUE)) {
    as.data.frame(readxl::read_excel(path), check.names = FALSE)
  } else {
    read.csv(path, check.names = FALSE, stringsAsFactors = FALSE)
  }
  if (ncol(x) < 2) stop("Abundance file needs sample IDs plus >= 1 sequence: ", path)
  ids <- trimws(as.character(x[[1]]))
  z <- x[, -1, drop = FALSE]
  z[] <- lapply(z, function(v) suppressWarnings(as.numeric(as.character(v))))
  m <- as.matrix(z); storage.mode(m) <- "numeric"
  m[!is.finite(m)] <- 0
  rownames(m) <- ids
  if (anyDuplicated(rownames(m))) stop("Duplicate sample names in: ", path)
  if (any(m < 0)) stop("Negative abundance values in: ", path)
  m <- m[rowSums(m) > 0, colSums(m) > 0, drop = FALSE]
  if (!nrow(m)) stop("No non-zero samples in: ", path)
  m / rowSums(m)
}

classify_type <- function(x) {
  dplyr::case_when(
    grepl("NTC|nega|PosCT|Undetermined", x, ignore.case = TRUE) ~ "Control",
    grepl("inlet", x, ignore.case = TRUE) ~ "Inlet",
    TRUE ~ "Experimental")
}

add_treatment_factors <- function(md, code) {
  code <- toupper(trimws(as.character(code)))
  code[code == "CONTROL"] <- "C"
  md$Treatment <- factor(code, levels = c("C", "H", "WF", "HWF"))
  md$Heat <- factor(ifelse(code %in% c("H", "HWF"), "Heat", "NoHeat"),
                    levels = c("NoHeat", "Heat"))
  md$Flow <- factor(ifelse(code %in% c("WF", "HWF"), "Flow", "NoFlow"),
                    levels = c("NoFlow", "Flow"))
  md
}

# Clade from a post-MED sequence name: C3 -> C, 8534_A -> A, C3.10 -> C
its2_clade <- function(x) {
  first <- toupper(substr(x, 1, 1))
  last <- toupper(sub("^.*_([A-Za-z])$", "\\1", x))
  out <- ifelse(grepl("^[A-Za-z]", x), first,
                ifelse(grepl("_[A-Za-z]$", x), last, NA_character_))
  ifelse(out %in% LETTERS[1:9], out, "Other")
}

tank_key <- function(ids, ord) {
  x <- tolower(strip_suffix(ids))
  date <- sub("-.*$", "", x)
  date <- ifelse(nchar(date) == 6, paste0("20", date), date)
  rest <- sub("^[^-]*-", "", x)
  tank <- suppressWarnings(as.integer(sub("^([0-9]+).*$", "\\1", rest)))
  key <- ifelse(grepl("^[0-9]", rest), sprintf("%s-%02d", date, tank),
                paste0(date, "-", rest))
  tmp <- data.frame(key = key, ord = ord) |>
    dplyr::group_by(key) |>
    dplyr::mutate(n = dplyr::n(), r = rank(ord, ties.method = "first")) |>
    dplyr::ungroup()
  ifelse(tmp$n > 1, paste0(tmp$key, tmp$r), tmp$key)
}

# ---- Loaders (unchanged logic from the previous script) ----------------------
load_tank <- function(file_path, meta_path) {
  abund <- read_abund(file_path)
  meta <- as.data.frame(readxl::read_excel(meta_path), check.names = FALSE)
  meta <- meta[!is.na(meta[[1]]), , drop = FALSE]
  info_col <- names(meta)[tolower(trimws(names(meta))) == "info"]
  if (!length(info_col)) stop("Tank metadata needs an 'info' column.")
  tank_col <- names(meta)[tolower(trimws(names(meta))) == "tank"]
  meta$join_key <- tank_key(meta[[1]], seq_len(nrow(meta)))
  meta <- meta[!duplicated(meta$join_key), , drop = FALSE]

  ids <- rownames(abund)
  s_num <- suppressWarnings(as.integer(sub("^.*_S([0-9]+)$", "\\1", ids)))
  s_num[is.na(s_num)] <- seq_along(ids)[is.na(s_num)]
  md <- data.frame(sample_name = ids, join_key = tank_key(ids, s_num),
                   stringsAsFactors = FALSE)
  md$Type <- classify_type(md$sample_name)
  cat("\nSample types in abundance table:\n"); print(table(md$Type))
  md <- md[md$Type %in% c("Experimental", "Inlet"), , drop = FALSE]
  is_inlet <- md$Type == "Inlet"

  tank_no <- suppressWarnings(as.integer(sub("^[^-]*-([0-9]+).*$", "\\1", md$sample_name)))
  if (CFG$inlets_as_background) {
    tank_no[is_inlet] <- 0L
  } else if (length(tank_col)) {
    inlet_tank <- suppressWarnings(as.integer(
      meta[[tank_col[1]]][match(md$join_key, meta$join_key)]))
    tank_no[is_inlet] <- inlet_tank[is_inlet]
  } else stop("inlets_as_background = FALSE but no 'tank' column exists.")

  no_tank <- is.na(tank_no)
  if (any(no_tank)) {
    cat("Dropping samples without a tank number:\n",
        paste(md$sample_name[no_tank], collapse = ", "), "\n")
    md <- md[!no_tank, , drop = FALSE]; tank_no <- tank_no[!no_tank]
    is_inlet <- is_inlet[!no_tank]
  }

  codes <- c("C", "H", "WF", "HWF")
  info <- toupper(trimws(as.character(meta[[info_col[1]]][match(md$join_key, meta$join_key)])))
  pattern <- "^.*-[0-9]{2}(HWF|WF|H|C)(_S[0-9]+)?$"
  id_code <- ifelse(grepl(pattern, md$sample_name),
                    sub(pattern, "\\1", md$sample_name), NA_character_)
  use_id <- !(info %in% codes) & !is_inlet
  code <- ifelse(use_id, id_code, info)
  code[is_inlet] <- NA_character_
  md <- add_treatment_factors(md, code)
  md$Heat[is_inlet] <- NA; md$Flow[is_inlet] <- NA

  date_chr <- sub("-.*$", "", md$sample_name)
  date_chr <- ifelse(nchar(date_chr) == 6, paste0("20", date_chr), date_chr)
  md$Date_d <- as.Date(date_chr, format = "%Y%m%d")
  if (anyNA(md$Date_d)) stop("Could not parse dates from: ",
                             paste(md$sample_name[is.na(md$Date_d)], collapse = ", "))
  md$Date <- factor(format(md$Date_d, "%Y%m%d"),
                    levels = sort(unique(format(md$Date_d, "%Y%m%d"))))
  md$Tank <- factor(ifelse(tank_no == 0L, "Inlet", sprintf("T%02d", tank_no)))
  md$SampleKind <- factor(ifelse(is_inlet, "Inlet", "Water"), levels = c("Water", "Inlet"))
  bad <- !is_inlet & is.na(md$Treatment)
  if (any(bad)) stop("No treatment for: ", paste(md$sample_name[bad], collapse = ", "))
  md <- md[order(md$Date_d, md$Tank, md$SampleKind), , drop = FALSE]
  rownames(md) <- md$sample_name
  list(abund = abund[md$sample_name, , drop = FALSE], metadata = md)
}

load_host <- function(file_path, meta_path) {
  abund <- read_abund(file_path)
  meta <- as.data.frame(readxl::read_excel(meta_path), check.names = FALSE)
  names(meta)[1] <- "sample"
  names(meta) <- tolower(trimws(names(meta)))
  shade_col <- grep("shad", names(meta), ignore.case = TRUE, value = TRUE)[1]
  needed <- c("tank", "condition", "species")
  if (!all(needed %in% names(meta)) || is.na(shade_col)) {
    stop("Host metadata needs tank, condition, species and a shading column.")
  }
  meta$join_key <- tolower(gsub("-", "_", strip_suffix(meta$sample)))
  meta <- meta[!is.na(meta$sample) & !duplicated(meta$join_key), , drop = FALSE]
  ids <- rownames(abund)
  md <- data.frame(sample_name = ids,
                   join_key = tolower(gsub("-", "_", strip_suffix(ids))),
                   stringsAsFactors = FALSE)
  md$Type <- classify_type(md$sample_name)
  md <- md[md$Type == "Experimental", , drop = FALSE]
  ix <- match(md$join_key, meta$join_key)
  if (anyNA(ix)) cat("Host samples lacking metadata (dropped): ",
                     paste(md$sample_name[is.na(ix)], collapse = ", "), "\n")
  md <- md[!is.na(ix), , drop = FALSE]; ix <- ix[!is.na(ix)]
  md <- add_treatment_factors(md, meta$condition[ix])
  md$Tank <- factor(sprintf("T%02d", as.integer(meta$tank[ix])))
  md$Shade <- factor(ifelse(trimws(as.character(meta[[shade_col]][ix])) == "S",
                            "Shaded", "NotShaded"))
  md$Species <- factor(trimws(as.character(meta$species[ix])))
  md$Genus <- factor(sub(" .*$", "", trimws(as.character(meta$species[ix]))))
  md <- md[order(md$Tank, md$Species), , drop = FALSE]
  rownames(md) <- md$sample_name
  list(abund = abund[md$sample_name, , drop = FALSE], metadata = md)
}

