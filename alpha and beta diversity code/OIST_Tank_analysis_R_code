  sp_long <- data.frame(sample_name = rep(rownames(Ssp), ncol(Ssp)), Species = rep(colnames(Ssp), each = nrow(Ssp)),
                        Similarity = as.vector(Ssp))
  sp_long <- dplyr::left_join(sp_long, meta_p[, c("sample_name", "Tank", "Treatment")], by = "sample_name")
  write.csv(sp_long |> dplyr::group_by(Tank, Treatment, Species) |>
              dplyr::summarise(N_water = dplyr::n(), Mean_similarity = mean(Similarity, na.rm = TRUE), .groups = "drop"),
            file.path(dirH, "Host_species_similarity_by_tank.csv"), row.names = FALSE)
  write.csv(as.data.frame.matrix(table(host_meta2$Tank, host_meta2$Species)),
            file.path(dirH, "Host_species_counts_per_tank.csv"))
}

# ---- Inlets ----
inlet_rows <- meta_all$SampleKind == "Inlet"
if (any(inlet_rows)) {
  im <- meta_all[inlet_rows, , drop = FALSE]
  ia_ <- align_seqs(abund_all[im$sample_name, , drop = FALSE], seqs)
  i_dates <- as.character(im$Date_d)
  inlet_means <- do.call(rbind, lapply(split(rownames(ia_), i_dates), function(ids) colMeans(ia_[ids, , drop = FALSE], na.rm = TRUE)))
  Sin <- sim_matrix(water_al, inlet_means, "bray")
  wd <- as.character(meta_p$Date_d)
  ci <- match(wd, colnames(Sin)); same <- rep(NA_real_, nrow(Sin)); ok <- !is.na(ci)
  same[ok] <- Sin[cbind(which(ok), ci[ok])]
  other <- (rowSums(Sin, na.rm = TRUE) - ifelse(is.na(same), 0, same)) / (ncol(Sin) - ifelse(is.na(same), 0, 1))
  inl <- cbind(hs[, c("sample_name", "Tank", "Treatment", "Date_d")],
               Inlet_available = ok, Sim_same_date_inlet = round(same, 8),
               Sim_other_date_inlets_mean = other, Advantage_same_minus_other = round(same - other, 8))
  write.csv(inl, file.path(dirH, "Tank_water_similarity_to_inlet.csv"), row.names = FALSE)
  pri <- perm_own_advantage(Sin, wd, CFG$nperm)
  write.csv(data.frame(Test = "Same-date vs other-date inlet similarity (date labels permuted)",
                       Mean_advantage = pri["obs"], Null_mean = pri["null_mean"], p_one_sided = pri["p"], N_dates = pri["k"], row.names = NULL),
            file.path(dirH, "Inlet_date_permutation_test.csv"), row.names = FALSE)
  top_seq <- apply(ia_, 1, function(x) names(which.max(x)))
  inlet_qc <- data.frame(Inlet_sample = rownames(ia_), Date_d = im$Date_d, N_sequences = rowSums(ia_ > 0),
                         Top_sequence = top_seq, Top_share = apply(ia_, 1, max))
  write.csv(inlet_qc, file.path(dirH, "Inlet_per_sample_QC.csv"), row.names = FALSE)
  date_qc <- inl |> dplyr::group_by(Date_d) |>
    dplyr::summarise(N_water = dplyr::n(), Inlet_available = any(Inlet_available),
                     Mean_sim = mean(Sim_same_date_inlet, na.rm = TRUE), Max_sim = if (any(!is.na(Sim_same_date_inlet))) max(Sim_same_date_inlet, na.rm = TRUE) else NA_real_,
                     Flag_zero_similarity_all_tanks = Inlet_available & all(Sim_same_date_inlet < 1e-6, na.rm = TRUE), .groups = "drop")
  write.csv(date_qc, file.path(dirH, "Inlet_date_QC.csv"), row.names = FALSE)

  # Overlap fractions, with the other-tank host reference as a baseline.
  R_all <- ref_from_hosts(host_al, as.character(host_meta2$Tank))
  frac <- function(x, h, il) c(Host_and_inlet = sum(x[h & il]), Host_only = sum(x[h & !il]),
                               Inlet_only = sum(x[!h & il]), Neither = sum(x[!h & !il]))
  ov <- lapply(seq_len(nrow(meta_p)), function(i) {
    tk <- wt[i]; dt <- wd[i]
    if (!(tk %in% rownames(R_all)) || !(dt %in% rownames(inlet_means))) return(NULL)
    x <- water_al[i, ]; il <- inlet_means[dt, ] > 0
    own <- frac(x, R_all[tk, ] > 0, il)
    oth <- Reduce("+", lapply(setdiff(rownames(R_all), tk), function(o) frac(x, R_all[o, ] > 0, il))) / (nrow(R_all) - 1)
    data.frame(sample_name = meta_p$sample_name[i], Tank = tk, Treatment = as.character(meta_p$Treatment[i]), Date_d = meta_p$Date_d[i],
               t(own), Host_total_own = own[1] + own[2],
               Host_total_other_tank_ref_mean = oth[1] + oth[2], row.names = NULL)
  })
  ov <- dplyr::bind_rows(ov)
  if (nrow(ov)) {
    ov$Host_total_advantage <- ov$Host_total_own - ov$Host_total_other_tank_ref_mean
    write.csv(ov, file.path(dirH, "Reference_overlap_per_sample.csv"), row.names = FALSE)
    ovs <- ov |> dplyr::group_by(Treatment, Date_d) |>
      dplyr::summarise(dplyr::across(c(Host_and_inlet, Host_only, Inlet_only, Neither), mean), N_tanks = dplyr::n_distinct(Tank), .groups = "drop")
    write.csv(ovs, file.path(dirH, "Reference_overlap_summary.csv"), row.names = FALSE)
    p <- ggplot(tidyr::pivot_longer(ovs, c(Host_and_inlet, Host_only, Inlet_only, Neither), names_to = "Overlap", values_to = "Fraction"),
                aes(Date_d, Fraction, fill = Overlap)) + geom_col() + facet_wrap(~ Treatment, ncol = 2) +
      theme_bw(base_size = 11) +
      labs(title = "Water read fraction by reference overlap (descriptive, not source apportionment)",
           x = "Sampling date", y = "Mean fraction")
    ggsave(file.path(dirH, "Reference_overlap_over_time.png"), p, width = 10, height = 7, dpi = 300)
  }
} else message("No inlet samples found; inlet analyses skipped.")

# =============================================================================
# SEQUENCE-LEVEL TESTS WITH TANKS AS REPLICATES (replaces SIMPER p-values)
# =============================================================================
tm_all <- collapse_mean(abund_p, as.character(meta_p$Tank))
tinfo <- as.data.frame(dplyr::distinct(meta_p, Tank, Heat, Flow)); rownames(tinfo) <- as.character(tinfo$Tank)
tinfo <- tinfo[rownames(tm_all), ]
keep <- colMeans(abund_p > 0) >= CFG$seq_test_prev_min
X <- tm_all[, keep, drop = FALSE]
seq_res <- list()
for (fac in c("Heat", "Flow")) {
  lab <- as.integer(tinfo[[fac]] == levels(tinfo[[fac]])[2])
  n1 <- sum(lab); n0 <- sum(1 - lab)
  obs <- colMeans(X[lab == 1, , drop = FALSE]) - colMeans(X[lab == 0, , drop = FALSE])
  set.seed(CFG$seed)
  perms <- replicate(CFG$nperm, sample(lab))                       # tanks x nperm
  null <- (t(perms) %*% X) / n1 - (t(1 - perms) %*% X) / n0       # nperm x seqs
  exceed <- colSums(abs(null) >= matrix(abs(obs), nrow(null), ncol(null), byrow = TRUE))
  pv <- (1 + exceed) / (1 + CFG$nperm)
  seq_res[[fac]] <- data.frame(Factor = fac, ITS2_sequence = colnames(X), Clade = clade_of[colnames(X)],
                               Tank_mean_level1 = colMeans(X[lab == 1, , drop = FALSE]),
                               Tank_mean_level0 = colMeans(X[lab == 0, , drop = FALSE]),
                               Diff_level1_minus_level0 = obs, N_tanks_level1 = n1, N_tanks_level0 = n0,
                               p_perm = pv, p_BH = p.adjust(pv, "BH"), row.names = NULL)
}
write.csv(dplyr::bind_rows(seq_res) |> dplyr::arrange(p_perm),
          file.path(dirH, "Sequence_tank_level_tests_Heat_Flow.csv"), row.names = FALSE)

if (CFG$run_simper) {
  sp <- tryCatch(vegan::simper(abund_p, group = meta_p$Treatment, permutations = 0), error = function(e) NULL)
  if (!is.null(sp)) {
    st <- lapply(names(summary(sp)), function(cmp) {
      z <- as.data.frame(summary(sp)[[cmp]]); z$ITS2_sequence <- rownames(z); z$Comparison <- cmp
      z[, intersect(c("Comparison", "ITS2_sequence", "average", "ava", "avb", "cumsum"), names(z))]
    })
    write.csv(dplyr::bind_rows(st), file.path(dirH, "SIMPER_descriptive_no_pvalues.csv"), row.names = FALSE)
  }
}

