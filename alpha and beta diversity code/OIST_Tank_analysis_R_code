# ---- Host-reference similarity with permutation null ----
ref_from_hosts <- function(H, group) {
  g <- split(rownames(H), group)
  r <- do.call(rbind, lapply(g, function(ids) colMeans(H[ids, , drop = FALSE], na.rm = TRUE)))
  r[!is.na(rowSums(r)), , drop = FALSE]
}

eval_ref <- function(Sim, lab) {
  n <- nrow(Sim); own_idx <- match(lab, colnames(Sim))
  own <- rep(NA_real_, n); ok <- !is.na(own_idx)
  own[ok] <- Sim[cbind(which(ok), own_idx[ok])]
  oth <- (rowSums(Sim, na.rm = TRUE) - own) / (ncol(Sim) - 1)
  oth[is.na(own)] <- NA_real_
  rk <- vapply(seq_len(n), function(i) if (is.na(own[i])) NA_real_ else 1 + sum(Sim[i, ] > own[i], na.rm = TRUE), numeric(1))
  nearest <- apply(Sim, 1, function(s) if (all(is.na(s))) NA_character_ else colnames(Sim)[which.max(s)])
  data.frame(Sim_own = own, Sim_other_mean = oth, Advantage = own - oth, Rank_own = rk, Nearest = nearest)
}

perm_own_advantage <- function(Sim, lab, nperm) {
  ok <- !is.na(rowSums(Sim))
  S <- rowsum(Sim[ok, , drop = FALSE], lab[ok])
  n <- table(factor(lab[ok], levels = rownames(S))); S <- S / as.numeric(n)
  common <- intersect(rownames(S), colnames(S)); k <- length(common)
  if (k < 3) return(c(obs = NA, p = NA, k = k, null_mean = NA))
  S <- S[common, common, drop = FALSE]; w <- as.numeric(n[common])
  adv <- function(pi) { own <- S[cbind(seq_len(k), pi)]; sum(w * (own - (rowSums(S) - own) / (k - 1))) / sum(w) }
  obs <- adv(seq_len(k)); set.seed(CFG$seed)
  null <- replicate(nperm, adv(sample.int(k)))
  c(obs = obs, p = (1 + sum(null >= obs)) / (1 + nperm), k = k, null_mean = mean(null))
}

