# ---- Shared helpers -----------------------------------------------------------
align_seqs <- function(x, seqs) {
  x <- as.matrix(x)
  out <- matrix(0, nrow(x), length(seqs), dimnames = list(rownames(x), seqs))
  out[, colnames(x)] <- x
  rs <- rowSums(out); ok <- rs > 0
  out[ok, ] <- out[ok, , drop = FALSE] / rs[ok]
  out[!ok, ] <- NA_real_
  out
}

collapse_mean <- function(x, group) {
  z <- rowsum(as.matrix(x), group, reorder = TRUE)
  z / as.numeric(table(factor(group, levels = rownames(z))))
}

renorm <- function(M) {
  rs <- rowSums(M); ok <- !is.na(rs) & rs > 0
  M[ok, ] <- M[ok, , drop = FALSE] / rs[ok]
  M[!ok, ] <- NA_real_
  M
}

# Bray-Curtis similarity (rows normalised) or Jaccard similarity (presence).
sim_matrix <- function(W, R, method = c("bray", "jaccard")) {
  method <- match.arg(method)
  out <- matrix(NA_real_, nrow(W), nrow(R), dimnames = list(rownames(W), rownames(R)))
  if (method == "bray") {
    for (j in seq_len(nrow(R))) out[, j] <- 1 - 0.5 * rowSums(abs(sweep(W, 2, R[j, ])))
  } else {
    Wp <- (W > 0) * 1; Rp <- (R > 0) * 1
    inter <- Wp %*% t(Rp)
    uni <- outer(rowSums(Wp), rowSums(Rp), "+") - inter
    out[] <- inter / uni
  }
  out
}

