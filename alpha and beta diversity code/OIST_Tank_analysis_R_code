safe_pcoa <- function(d, metadata, file, title, dir) {
  pc <- tryCatch(ape::pcoa(d), error = function(e) NULL)
  if (is.null(pc) || ncol(pc$vectors) < 2) return(invisible(NULL))
  co <- as.data.frame(pc$vectors[, 1:2, drop = FALSE]); co$sample_name <- rownames(co)
  pd <- dplyr::left_join(co, metadata, by = "sample_name")
  pct <- round(100 * pc$values$Relative_eig[1:2], 1)
  p <- ggplot(pd, aes(Axis.1, Axis.2, colour = Treatment)) +
    geom_point(size = 2.8, alpha = 0.85) +
    scale_colour_manual(values = TREATMENT_COLS, drop = FALSE) +
    theme_bw(base_size = 12) +
    labs(title = title, x = paste0("PCoA1 (", pct[1], "%)"), y = paste0("PCoA2 (", pct[2], "%)"))
  ggsave(file.path(dir, file), p, width = 8, height = 6, dpi = 300)
}

line_plot <- function(data, y, ylab, file, dir, title = ylab) {
  z <- data[!is.na(data[[y]]), , drop = FALSE]
  if (!nrow(z)) return(invisible(NULL))
  p <- ggplot(z, aes(Date_d, .data[[y]], colour = Treatment,
                     group = interaction(Treatment, Tank))) +
    geom_line(alpha = 0.25) + geom_point(alpha = 0.55, size = 1.5) +
    stat_summary(aes(group = Treatment), fun = mean, geom = "line", linewidth = 1.1) +
    scale_colour_manual(values = TREATMENT_COLS) + theme_bw(base_size = 12) +
    labs(x = "Sampling date", y = ylab, title = title)
  ggsave(file.path(dir, file), p, width = 9, height = 5.5, dpi = 300)
}

# ---- Model helpers ------------------------------------------------------------
tidy_fixed <- function(m, label, tag, note = "") {
  if (inherits(m, "glmmTMB")) {
    cf <- as.data.frame(coef(summary(m))$cond)
    names(cf) <- c("Estimate", "SE", "stat", "p"); cf$df <- Inf
    note <- paste0(note, " pdHess=", isTRUE(m$sdr$pdHess))
  } else {
    cf <- as.data.frame(coef(summary(m)))
    names(cf) <- c("Estimate", "SE", "df", "stat", "p")
  }
  crit <- qt(0.975, cf$df)
  data.frame(Scenario = tag, Response = label, Term = rownames(cf),
             Estimate = cf$Estimate, SE = cf$SE,
             CI_low = cf$Estimate - crit * cf$SE, CI_high = cf$Estimate + crit * cf$SE,
             p = cf$p, Approx_MDE_80pct = 2.8 * cf$SE,
             Note = trimws(note), row.names = NULL)
}

var_comp <- function(m, label, tag) {
  out <- tryCatch({
    if (inherits(m, "glmmTMB")) {
      vc <- glmmTMB::VarCorr(m)$cond
      data.frame(Group = names(vc), Variance = vapply(vc, function(x) as.numeric(x[1, 1]), numeric(1)))
    } else {
      vc <- as.data.frame(lme4::VarCorr(m))
      data.frame(Group = vc$grp, Variance = vc$vcov)
    }
  }, error = function(e) NULL)
  if (is.null(out)) return(NULL)
  out$Share <- out$Variance / sum(out$Variance)
  out$Near_zero <- out$Variance < 1e-6 * max(out$Variance, 1e-12)
  data.frame(Scenario = tag, Response = label, out, row.names = NULL)
}

finish_model <- function(m, label, tag, dir, diagnostics = TRUE) {
  capture.output(summary(m), file = file.path(dir, paste0("Model_", label, "_summary.txt")))
  an <- tryCatch(
    if (inherits(m, "glmmTMB")) as.data.frame(car::Anova(m, type = "III")) else as.data.frame(anova(m)),
    error = function(e) NULL)
  if (!is.null(an)) {
    write.csv(an, file.path(dir, paste0("Model_", label, "_tests.csv")))
    an$Term <- rownames(an); collect("anova", cbind(Scenario = tag, Response = label, an))
  }
  collect("effects", tidy_fixed(m, label, tag))
  collect("vc", var_comp(m, label, tag))
  if (diagnostics) {
    png(file.path(dir, paste0("Model_", label, "_diagnostics.png")), width = 1100, height = 500)
    par(mfrow = c(1, 2))
    r <- if (inherits(m, "glmmTMB")) residuals(m, type = "pearson") else resid(m)
    plot(fitted(m), r, xlab = "Fitted", ylab = "Residuals", main = paste(label, "residuals")); abline(h = 0, lty = 2)
    qqnorm(r, main = paste(label, "Q-Q")); qqline(r)
    dev.off()
  }
  if (!inherits(m, "glmmTMB")) {
    sr <- resid(m) / sigma(m)
    if (any(abs(sr) > 3)) {
      write.csv(data.frame(sample_name = names(sr)[abs(sr) > 3], scaled_resid = sr[abs(sr) > 3]),
                file.path(dir, paste0("Model_", label, "_outliers.csv")), row.names = FALSE)
    }
  }
  m
}

fit_gauss <- function(resp, data, rhs, tag, dir, label = resp) {
  d <- data[!is.na(data[[resp]]), , drop = FALSE]
  f <- as.formula(paste(resp, "~", rhs, "+ (1 | Tank) + (1 | Date)"))
  m <- tryCatch(lmerTest::lmer(f, data = d, REML = TRUE),
                error = function(e) { message("  LMM failed (", label, "): ", conditionMessage(e)); NULL })
  if (is.null(m)) return(NULL)
  finish_model(m, label, tag, dir)
}

fit_nb <- function(resp, data, rhs, tag, dir, label = resp) {
  d <- data[!is.na(data[[resp]]), , drop = FALSE]
  f <- as.formula(paste(resp, "~", rhs, "+ (1 | Tank) + (1 | Date)"))
  m <- tryCatch(glmmTMB::glmmTMB(f, data = d, family = glmmTMB::nbinom2),
                error = function(e) { message("  NB GLMM failed (", label, "): ", conditionMessage(e)); NULL })
  if (is.null(m)) return(NULL)
  finish_model(m, label, tag, dir)
}

# Sensitivity: Ornstein-Uhlenbeck autocorrelation within tank (irregular dates).
fit_ou <- function(resp, data, rhs, tag, dir, label = resp) {
  d <- data[!is.na(data[[resp]]), , drop = FALSE]
  if (anyDuplicated(paste(d$Tank, d$Day_from_first_water))) return(NULL)
  d$times <- glmmTMB::numFactor(d$Day_from_first_water)
  f <- as.formula(paste(resp, "~", rhs, "+ (1 | Date) + ou(times + 0 | Tank)"))
  m <- tryCatch(glmmTMB::glmmTMB(f, data = d, family = gaussian(), REML = TRUE),
                error = function(e) { message("  OU model failed (", label, "): ", conditionMessage(e)); NULL })
  if (is.null(m)) return(NULL)
  finish_model(m, paste0(label, "_OU"), tag, dir, diagnostics = FALSE)
}

# ---- Trajectories ---------------------------------------------------------------
build_traj <- function(meta_s, dmat) {
  tr <- meta_s
  tr$Drift_from_first <- NA_real_; tr$Turnover_from_prev <- NA_real_
  tr$Days_between <- NA_real_; tr$Days_from_tank_first <- NA_real_
  tr$Is_tank_first <- FALSE
  for (tk in levels(tr$Tank)) {
    ix <- which(tr$Tank == tk); ix <- ix[order(tr$Date_d[ix])]
    if (!length(ix)) next
    tr$Is_tank_first[ix[1]] <- TRUE
    tr$Days_from_tank_first[ix] <- as.numeric(tr$Date_d[ix] - tr$Date_d[ix[1]])
    if (length(ix) < 2) next
    tr$Drift_from_first[ix[-1]] <- dmat[cbind(ix[-1], rep(ix[1], length(ix) - 1))]
    tr$Turnover_from_prev[ix[-1]] <- dmat[cbind(ix[-1], ix[-length(ix)])]
    tr$Days_between[ix[-1]] <- as.numeric(diff(tr$Date_d[ix]))
  }
  tr$LogGap_sc <- as.numeric(scale(log(tr$Days_between)))
  rownames(tr) <- tr$sample_name
  tr
}

# ---- Beta-diversity helpers ------------------------------------------------------
tank_mean_for <- function(meta_s, abund_s, dates) {
  rows <- meta_s$Date_d %in% dates
  m <- meta_s[rows, , drop = FALSE]; a <- abund_s[rows, , drop = FALSE]
  tm <- collapse_mean(a, as.character(m$Tank))
  info <- as.data.frame(dplyr::distinct(m, Tank, Treatment, Heat, Flow))
  rownames(info) <- as.character(info$Tank)
  info <- droplevels(info[rownames(tm), , drop = FALSE])
  info$sample_name <- rownames(info)
  list(tm = tm, info = info)
}

run_adonis <- function(tm, info, method, nperm, variant, tag) {
  d <- vegan::vegdist(tm, method = method, binary = method == "jaccard")
  fits <- list(
    additive_margin = quote(vegan::adonis2(d ~ Heat + Flow, data = info, permutations = nperm, by = "margin")),
    factorial_terms = quote(vegan::adonis2(d ~ Heat * Flow, data = info, permutations = nperm, by = "terms")),
    treatment_4level = quote(vegan::adonis2(d ~ Treatment, data = info, permutations = nperm)))
  out <- lapply(names(fits), function(nm) {
    set.seed(CFG$seed)
    z <- as.data.frame(eval(fits[[nm]]))
    z$Term <- rownames(z)
    data.frame(Scenario = tag, Test = "PERMANOVA_tank_mean", Variant = variant, Metric = method,
               Model = nm, z, row.names = NULL, check.names = FALSE)
  })
  dplyr::bind_rows(out)
}

run_betadisper <- function(tm, info, method, nperm, variant, tag) {
  d <- vegan::vegdist(tm, method = method, binary = method == "jaccard")
  dplyr::bind_rows(lapply(c("Treatment", "Heat", "Flow"), function(g) {
    bd <- vegan::betadisper(d, info[[g]], bias.adjust = TRUE)
    set.seed(CFG$seed)
    pt <- vegan::permutest(bd, permutations = nperm)
    data.frame(Scenario = tag, Test = "Betadisper", Variant = variant, Metric = method,
               Model = g, F = pt$tab[1, "F"], p = pt$tab[1, "Pr(>F)"])
  }))
}

pair_table <- function(meta_s, Bm, Jm) {
  idx <- split(seq_len(nrow(meta_s)), as.character(meta_s$Date_d))
  rows <- lapply(idx, function(ix) {
    if (length(ix) < 2) return(NULL)
    cb <- t(utils::combn(ix, 2)); a <- cb[, 1]; b <- cb[, 2]
    data.frame(Date_d = meta_s$Date_d[a],
               Tank_A = as.character(meta_s$Tank[a]), Tank_B = as.character(meta_s$Tank[b]),
               Treat_A = as.character(meta_s$Treatment[a]), Treat_B = as.character(meta_s$Treatment[b]),
               Bray = Bm[cbind(a, b)], Jaccard = Jm[cbind(a, b)])
  })
  pt <- dplyr::bind_rows(rows)
  pt <- pt[pt$Tank_A != pt$Tank_B, , drop = FALSE]
  pt$Pair_type <- paste(pmin(pt$Treat_A, pt$Treat_B), pmax(pt$Treat_A, pt$Treat_B), sep = "-")
  pt$Same_treatment <- pt$Treat_A == pt$Treat_B
  pt
}

# Tank-label permutation test using every date. Statistic = mean over dates of
# (between-group dissimilarity - within-group dissimilarity). Labels are
# permuted across whole tanks, so tanks, not samples, are the replicates.
tank_perm_test <- function(pt, tank_info, factor_name, dist_col, nperm, tag) {
  tanks <- as.character(tank_info$Tank)
  lab <- setNames(as.character(tank_info[[factor_name]]), tanks)
  ia <- match(pt$Tank_A, tanks); ib <- match(pt$Tank_B, tanks)
  di <- as.integer(factor(as.character(pt$Date_d)))
  d <- pt[[dist_col]]
  stat <- function(l) {
    same <- l[ia] == l[ib]
    ws <- rowsum(d * same, di)[, 1]; wn <- rowsum(as.numeric(same), di)[, 1]
    bs <- rowsum(d * !same, di)[, 1]; bn <- rowsum(as.numeric(!same), di)[, 1]
    ok <- wn > 0 & bn > 0
    if (!any(ok)) return(c(NA_real_, NA_real_, NA_real_, 0))
    c(mean(bs[ok] / bn[ok] - ws[ok] / wn[ok]), mean(ws[ok] / wn[ok]), mean(bs[ok] / bn[ok]), sum(ok))
  }
  obs <- stat(unname(lab)[match(tanks, tanks)])
  set.seed(CFG$seed)
  null <- replicate(nperm, stat(sample(unname(lab)))[1])
  data.frame(Scenario = tag, Test = "Tank_label_permutation_all_dates", Variant = "all_samples",
             Metric = dist_col, Model = factor_name, Statistic_between_minus_within = obs[1],
             Mean_within = obs[2], Mean_between = obs[3], N_dates_used = obs[4],
             p = (1 + sum(null >= obs[1], na.rm = TRUE)) / (1 + sum(!is.na(null))))
}

