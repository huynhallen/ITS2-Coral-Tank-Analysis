run_scenario <- function(tag, meta_s, abund_s) {
  dir <- file.path(CFG$out_dir, tag); dir.create(dir, recursive = TRUE, showWarnings = FALSE)
  cat("\n=== Scenario:", tag, "|", nrow(meta_s), "samples |", ncol(abund_s), "sequences ===\n")
  rhs_day <- make_rhs("Day_sc")

  ## ---- Alpha diversity ----
  alpha <- meta_s
  alpha$Richness <- rowSums(abund_s > 0)
  alpha$Shannon <- vegan::diversity(abund_s, "shannon")
  alpha$Simpson <- vegan::diversity(abund_s, "simpson")
  alpha$Evenness <- ifelse(alpha$Richness > 1, alpha$Shannon / log(alpha$Richness), NA_real_)
  rownames(alpha) <- alpha$sample_name
  write.csv(alpha[, c("sample_name", "Tank", "Treatment", "Heat", "Flow", "Date_d",
                      "Day_from_first_water", "Richness", "Shannon", "Simpson", "Evenness")],
            file.path(dir, "Alpha_diversity_per_sample.csv"), row.names = FALSE)
  alpha_long <- tidyr::pivot_longer(
    alpha[, c("sample_name", "Tank", "Treatment", "Date_d", "Richness", "Shannon", "Simpson", "Evenness")],
    c(Richness, Shannon, Simpson, Evenness), names_to = "Metric", values_to = "Value")
  # Tank means first, then treatment: tanks are the replicates.
  tank_means <- alpha_long |> dplyr::group_by(Treatment, Tank, Metric) |>
    dplyr::summarise(Tank_mean = mean(Value, na.rm = TRUE), N_samples = dplyr::n(), .groups = "drop")
  write.csv(tank_means, file.path(dir, "Alpha_tank_means.csv"), row.names = FALSE)
  write.csv(tank_means |> dplyr::group_by(Treatment, Metric) |>
              dplyr::summarise(N_tanks = dplyr::n(), Mean = mean(Tank_mean), SD = sd(Tank_mean), .groups = "drop"),
            file.path(dir, "Alpha_treatment_summary_tank_level.csv"), row.names = FALSE)
  write.csv(alpha_long |> dplyr::group_by(Treatment, Date_d, Metric) |>
              dplyr::summarise(N_tanks = dplyr::n_distinct(Tank), Mean = mean(Value, na.rm = TRUE),
                               SD = sd(Value, na.rm = TRUE), Low_n_flag = N_tanks < 3, .groups = "drop"),
            file.path(dir, "Alpha_treatment_date_summary.csv"), row.names = FALSE)
  p_alpha <- ggplot(alpha_long, aes(Date_d, Value, colour = Treatment, group = interaction(Treatment, Tank))) +
    geom_line(alpha = 0.25) + geom_point(alpha = 0.45, size = 1.5) +
    stat_summary(aes(group = Treatment), fun = mean, geom = "line", linewidth = 1.1) +
    facet_wrap(~ Metric, scales = "free_y", ncol = 2) +
    scale_colour_manual(values = TREATMENT_COLS) + theme_bw(base_size = 12) +
    labs(title = paste("ITS2 alpha diversity,", tag), x = "Sampling date", y = NULL)
  ggsave(file.path(dir, "Alpha_diversity_over_time.png"), p_alpha, width = 11, height = 7, dpi = 300)

  fit_nb("Richness", alpha, rhs_day, tag, dir, "Richness_NB")
  for (r in c("Shannon", "Simpson", "Evenness")) fit_gauss(r, alpha, rhs_day, tag, dir)
  if (CFG$run_ou && tag == "primary") for (r in c("Shannon", "Evenness")) fit_ou(r, alpha, rhs_day, tag, dir)

  ## ---- Trajectories ----
  Bm <- as.matrix(vegan::vegdist(abund_s, "bray"))
  Jm <- as.matrix(vegan::vegdist(abund_s, "jaccard", binary = TRUE))
  tr <- build_traj(meta_s, Bm)
  write.csv(tr[, c("sample_name", "Tank", "Treatment", "Heat", "Flow", "Date_d", "Is_tank_first",
                   "Days_from_tank_first", "Drift_from_first", "Turnover_from_prev", "Days_between")],
            file.path(dir, "Temporal_trajectory_metrics.csv"), row.names = FALSE)
  dd <- tr[!is.na(tr$Drift_from_first), , drop = FALSE]   # first samples excluded
  dd$DayTank_sc <- as.numeric(scale(dd$Days_from_tank_first))
  fit_gauss("Drift_from_first", dd, make_rhs("DayTank_sc"), tag, dir, "Drift_excl_first")
  td <- tr[!is.na(tr$Turnover_from_prev), , drop = FALSE]
  if (nrow(td) >= 20) fit_gauss("Turnover_from_prev", td, "Heat_c * Flow_c + LogGap_sc", tag, dir, "Turnover_loggap")
  line_plot(tr, "Drift_from_first", "Bray-Curtis from tank's first sample", "Drift_over_time.png", dir)
  line_plot(tr, "Turnover_from_prev", "Bray-Curtis between consecutive samples", "Turnover_over_time.png", dir)

  ## ---- Same-date tank pairs: replaces distance-to-control ----
  pt <- pair_table(meta_s, Bm, Jm)
  write.csv(pt, file.path(dir, "SameDate_tank_pair_distances.csv"), row.names = FALSE)
  write.csv(pt |> dplyr::group_by(Pair_type, Same_treatment) |>
              dplyr::summarise(N_pairs = dplyr::n(), Bray_mean = mean(Bray), Bray_sd = sd(Bray),
                               Jaccard_mean = mean(Jaccard), Jaccard_sd = sd(Jaccard), .groups = "drop"),
            file.path(dir, "SameDate_tank_pair_summary.csv"), row.names = FALSE)

  ## ---- Tank-level tests ----
  info_all <- as.data.frame(dplyr::distinct(meta_s, Tank, Treatment, Heat, Flow))
  info_all <- info_all[order(info_all$Tank), ]
  beta <- list()
  for (fac in c("Treatment", "Heat", "Flow"))
    for (dc in c("Bray", "Jaccard"))
      beta[[length(beta) + 1]] <- tank_perm_test(pt, info_all, fac, dc, CFG$nperm, tag)

  n_tanks <- nlevels(meta_s$Tank)
  cov_d <- meta_s |> dplyr::group_by(Date_d) |> dplyr::summarise(N = dplyr::n_distinct(Tank), .groups = "drop")
  bal_dates <- cov_d$Date_d[cov_d$N == n_tanks]
  variants <- list(all_dates_unbalanced = unique(meta_s$Date_d))
  if (length(bal_dates) >= 2) variants$balanced_dates <- bal_dates
  if (length(bal_dates) >= 3)
    for (d0 in seq_along(bal_dates))
      variants[[paste0("balanced_minus_", format(bal_dates[d0]))]] <- bal_dates[-d0]
  for (v in names(variants)) {
    tmv <- tank_mean_for(meta_s, abund_s, variants[[v]])
    np <- if (grepl("minus", v)) CFG$nperm_small else CFG$nperm
    for (mth in c("bray", "jaccard")) {
      beta[[length(beta) + 1]] <- run_adonis(tmv$tm, tmv$info, mth, np, v, tag)
      if (v %in% c("all_dates_unbalanced", "balanced_dates"))
        beta[[length(beta) + 1]] <- run_betadisper(tmv$tm, tmv$info, mth, np, v, tag)
    }
    if (v == "all_dates_unbalanced") {
      safe_pcoa(vegan::vegdist(tmv$tm, "bray"), tmv$info, "PCoA_tank_mean_Bray.png",
                paste("Tank means, Bray-Curtis,", tag), dir)
      safe_pcoa(vegan::vegdist(tmv$tm, "jaccard", binary = TRUE), tmv$info, "PCoA_tank_mean_Jaccard.png",
                paste("Tank means, Jaccard,", tag), dir)
    }
  }
  beta_tab <- dplyr::bind_rows(beta)
  write.csv(beta_tab, file.path(dir, "Beta_tests.csv"), row.names = FALSE)
  collect("beta", beta_tab)

  pc <- tryCatch(ape::pcoa(vegan::vegdist(abund_s, "bray")), error = function(e) NULL)
  if (!is.null(pc)) {
    pcd <- as.data.frame(pc$vectors[, 1:2, drop = FALSE]); pcd$sample_name <- rownames(pcd)
    pcd <- dplyr::left_join(pcd, meta_s, by = "sample_name") |> dplyr::arrange(Tank, Date_d)
    pct <- round(100 * pc$values$Relative_eig[1:2], 1)
    p <- ggplot(pcd, aes(Axis.1, Axis.2, colour = Treatment)) +
      geom_path(aes(group = Tank), alpha = 0.25) + geom_point(aes(shape = Tank), size = 2.2, alpha = 0.8) +
      scale_colour_manual(values = TREATMENT_COLS) + scale_shape_manual(values = seq_len(nlevels(pcd$Tank))) +
      theme_bw(base_size = 12) +
      labs(title = paste("Sample-level PCoA (descriptive),", tag),
           x = paste0("PCoA1 (", pct[1], "%)"), y = paste0("PCoA2 (", pct[2], "%)"))
    ggsave(file.path(dir, "PCoA_water_samples_tank_paths.png"), p, width = 9, height = 7, dpi = 300)
  }
  invisible(NULL)
}

